

BASE_DOMAIN="mieuxvoter.fr"

# Port this service will run on on the host.
SERVICE_PORT=8040

# Used to name the containers, for example.
# Only lowercase alphanumeric characters, hyphens, and underscores.
# Must start with a letter or number.
# This is safe to remove if you'd rather roll with the default naming scheme.
COMPOSE_PROJECT_NAME="redirect_mieuxvoter_fr"
